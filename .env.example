# Copie para .env (ignorado pelo Git) e troque TODOS os valores.
# Gere segredos aleatórios, por exemplo:  openssl rand -base64 48

DB_USER=greenagri
DB_PASSWORD=
# Mínimo 32 caracteres aleatórios. A API não sobe com valores de exemplo.
GREENAGRI_JWT_SECRET=
# Endereço(s) públicos do app, separados por vírgula.
GREENAGRI_CORS_ORIGENS=http://localhost:8081

# Opcional: carrega fazendas fictícias de demonstração no primeiro start.
GREENAGRI_SEED=false
# Senha dos usuários de demonstração (se vazio, é gerada e gravada em /tmp no container).
GREENAGRI_DEMO_SENHA=
